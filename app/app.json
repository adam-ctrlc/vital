{
  "expo": {
    "name": "Vital",
    "slug": "dynavolt",
    "owner": "peregrine.adrift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "dynavolt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/favicon.png",
      "bundleIdentifier": "com.peregrineadrift.vital"
    },
    "android": {
      "package": "com.peregrineadrift.vital",
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/images/favicon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/favicon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "alerts-v2",
          "sounds": [
            "./assets/sounds/chirp.wav",
            "./assets/sounds/alarm.wav",
            "./assets/sounds/beep.wav",
            "./assets/sounds/sweep.wav",
            "./assets/sounds/pulse.wav",
            "./assets/sounds/siren.wav",
            "./assets/sounds/warble.wav",
            "./assets/sounds/ping.wav",
            "./assets/sounds/tritone.wav",
            "./assets/sounds/descend.wav",
            "./assets/sounds/klaxon.wav",
            "./assets/sounds/trill.wav",
            "./assets/sounds/strobe.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/surge.wav",
            "./assets/sounds/blip.wav",
            "./assets/sounds/buzzer.wav",
            "./assets/sounds/chatter.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/dive.wav",
            "./assets/sounds/drone.wav",
            "./assets/sounds/echo.wav",
            "./assets/sounds/glass.wav",
            "./assets/sounds/heartbeat.wav",
            "./assets/sounds/ladder.wav",
            "./assets/sounds/march.wav",
            "./assets/sounds/radar.wav",
            "./assets/sounds/spark.wav",
            "./assets/sounds/tick.wav",
            "./assets/sounds/whoop.wav"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ea9033b-4165-466b-9b1e-8d01c60af1aa"
      }
    }
  }
}
