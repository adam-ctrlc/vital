DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
SIMULATOR_ENABLED=true
SAMPLE_INTERVAL_MS=1500

# Shared secret for the ESP32's x-device-key header. Leaving it unset rejects all
# hardware ingest; leaving it set but blank does too.
DEVICE_API_KEY=replace-with-a-long-random-secret

# Read by `cargo run --bin seed` only, never by the server. The seeder refuses to run
# without them rather than falling back to a known password.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
