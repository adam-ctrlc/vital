DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=replace-with-turso-token
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
SIMULATOR_ENABLED=true
SAMPLE_INTERVAL_MS=1500

# Shared secret for the ESP32's x-device-key header. Leaving it unset rejects all
# hardware ingest; leaving it set but blank does too.
DEVICE_API_KEY=replace-with-a-long-random-secret

# Read only by the Rust account seeder (api/src/bin/seed.rs), never by the server.
# The seeder refuses to run without them rather than fall back to a known password.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
